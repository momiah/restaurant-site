rules_version = '2';

// Restaurant images (logos, hero, menu photos) live under restaurants/{id}/...
// They are publicly readable (the website shows them) and writable only by a
// MenuDock platform admin (the admin console uploads them during onboarding).
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
