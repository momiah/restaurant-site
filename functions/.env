# Non-secret function params (firebase-functions/params). Secrets such as Stripe and
# Claude keys are NOT here: they live in Cloud Secret Manager (firebase functions:secrets:set).
PLATFORM_FEE_PERCENT=5
# Stripe's costs on each order, passed on to every restaurant on top of MenuDock's fee
# (Stripe takes them from MenuDock's account). UK cards: 1.5% + 20p; Connect payouts: 0.25%.
STRIPE_COVER_PERCENT=1.75
STRIPE_COVER_FIXED_PENCE=20
