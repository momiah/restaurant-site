# ---------------------------------------------------------------------------
# restaurant-site environment (Create React App reads REACT_APP_* at build time)
# Copy to .env.local and fill in. Nothing here is restaurant-specific except the
# RESTAURANT_* selector — the Firebase project is the shared PLATFORM project.
# ---------------------------------------------------------------------------

# Which restaurant this deployment serves. Set ONE of these for a single-tenant
# deploy (or local dev). Leave both blank to resolve by hostname:
#   domains/{hostname} -> restaurantId, then slug === first hostname label.
REACT_APP_RESTAURANT_ID=
REACT_APP_RESTAURANT_SLUG=taco-monster

# Base URL of the deployed Cloud Functions "payments" app
# (the code appends /stripe-session and /checkout-webhook).
REACT_APP_FUNCTIONS_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/payments

# Platform Firebase project (shared across all restaurants).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
