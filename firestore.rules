rules_version = '2';

// Multi-tenant Firestore rules.
// - Restaurant config + menu are world-readable (the public website needs them).
// - Orders can be created by the site, but only read/managed by the restaurant's
//   authenticated owner. The Cloud Functions webhook uses the Admin SDK, which
//   bypasses these rules, so it can still update payment status.
// - MenuDock platform admins (users with the `admin` custom claim) manage every
//   restaurant and can read all orders — this is what powers the admin console.
// - Everything not matched below is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // Platform super-admin: set the `admin: true` custom claim via the Admin SDK.
    function isAdmin() {
      return request.auth != null && request.auth.token.get("admin", false) == true;
    }

    // The restaurantId the signed-in user (a dashboard owner) is tied to.
    function ownerRestaurantId() {
      return get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.restaurantId;
    }
    function isOwnerOf(restaurantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && ownerRestaurantId() == restaurantId;
    }

    // Fields only MenuDock may change: where payouts go, what we charge, whether the
    // restaurant is live, and the slug its website/app resolve by.
    function changesCommercialFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["payments", "billing", "status", "slug"]);
    }

    // Public config. Only MenuDock creates or removes restaurants; an owner keeps their
    // own details up to date but can never touch the commercial fields above.
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwnerOf(restaurantId) && !changesCommercialFields());

      // Menu — world-readable (website + loyalty app), admin/owner writes.
      match /menu/{menuDoc} {
        allow read: if true;
        allow write: if isAdmin() || isOwnerOf(restaurantId);
      }

      // Offers & deals (loyalty, Phase 2) — world-readable, admin/owner writes.
      match /offers/{offerId} {
        allow read: if true;
        allow write: if isAdmin() || isOwnerOf(restaurantId);
      }

      // Loyalty customer profiles — PRIVATE to that customer (or the restaurant/admin).
      // Points are awarded only by the Stripe webhook (Admin SDK): a customer can create
      // their profile with zero points and edit their details, never their balance.
      // Owners/admins can adjust balances (e.g. a goodwill top-up).
      match /customers/{uid} {
        function isSelf() {
          return request.auth != null && request.auth.uid == uid;
        }
        allow read: if isAdmin() || isOwnerOf(restaurantId) || isSelf();
        allow create: if isAdmin() || isOwnerOf(restaurantId)
          || (isSelf()
            && request.resource.data.get("points", 0) == 0
            && request.resource.data.get("lifetimePoints", 0) == 0);
        allow update: if isAdmin() || isOwnerOf(restaurantId)
          || (isSelf()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(["points", "lifetimePoints"]));
        allow delete: if isAdmin() || isOwnerOf(restaurantId);

        // Points ledger, one entry per order. Written only by the server.
        match /pointsHistory/{entryId} {
          allow read: if isAdmin() || isOwnerOf(restaurantId) || isSelf();
          allow write: if false;
        }
      }

      // Points from orders whose email doesn't belong to a member yet, waiting to be
      // claimed (claimLoyaltyPoints). Written only by the server.
      match /unclaimedPoints/{orderId} {
        allow read: if isAdmin() || isOwnerOf(restaurantId);
        allow write: if false;
      }
    }

    // Hostname -> restaurant lookup used to resolve the tenant. Admin-managed.
    match /domains/{hostname} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Maps a dashboard user to their restaurant. Readable by that user or an admin.
    match /owners/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Admin directory (fallback admin check for the console). Readable by that admin.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // provisioned out-of-band
    }

    // Kitchen workflow for a paid order: placed -> preparing -> ready -> completed.
    // Wording per order type (e.g. "ready" = "Out for delivery" / "Ready to collect")
    // lives in the apps; see docs/ORDER_STATUS.md.
    function isStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "statusTimes"])
        && resource.data.payment_status == "paid"
        && request.resource.data.status in ["placed", "preparing", "ready", "completed"];
    }

    // Orders live top-level, scoped by restaurantId.
    match /orders/{orderId} {
      // Orders are created only by the checkout function (Admin SDK), which prices
      // them from the menu. A client-written order could claim any items or total.
      allow create: if false;
      // A customer follows their order by its id. Ids are Stripe Checkout session ids
      // (long and unguessable) that only the customer receives, in their confirmation
      // link. Listing or querying orders stays restricted to the owner and admins.
      allow get: if true;
      // Owners list their restaurant's orders; a signed-in customer lists their own
      // app orders (customerUid is set by the checkout function from their ID token).
      allow list: if isAdmin() || isOwnerOf(resource.data.restaurantId)
        || (request.auth != null && resource.data.customerUid == request.auth.uid);
      // The owner moves their own paid orders through the kitchen workflow. Nothing else
      // on an order can change from a client: payment and order numbers come from the
      // Stripe webhook (Admin SDK).
      allow update: if isOwnerOf(resource.data.restaurantId) && isStatusUpdate();
      allow delete: if false;
    }
  }
}
